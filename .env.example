# Authentication (NextAuth)
NEXTAUTH_URL=http://localhost:3000
# Generate a secret using `openssl rand -base64 32`
NEXTAUTH_SECRET=your_nextauth_secret_here

# Database
# Required for storing user progress, chat history, and profiles
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/ai_mentor?retryWrites=true&w=majority

# AI Mentor (Groq)
# Required for the AI Mentor Chat feature
GROQ_API_KEY=your_groq_api_key_here

# Optional: Google OAuth for Sign In
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
